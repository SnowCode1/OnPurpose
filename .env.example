# Copy to .env.local. Never put real secrets in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_DEV_PREVIEW=false
# Your computer's LAN IP (not localhost); keep the phone on the same network.
EXPO_PUBLIC_PREVIEW_URL=http://192.168.1.100:8765
# Generate a local pairing token: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# This is embedded in the development app; it is not a production credential.
EXPO_PUBLIC_PREVIEW_TOKEN=
