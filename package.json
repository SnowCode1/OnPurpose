{
  "name": "onpurpose",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.26",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "start:clear": "expo start --go --clear",
    "start:tunnel": "expo start --go --tunnel",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "doctor": "npx expo-doctor@latest",
    "export:ios": "expo export --platform ios",
    "preview:server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/preview-server.mjs",
    "test:preview": "node --test scripts/preview-receiver.test.mjs",
    "test:calendar": "node --test scripts/calendar.test.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
